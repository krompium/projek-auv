<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.dji.sdk.sample.internal.view.BaseFpvView
        android:id="@+id/base_fpv_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Telemetry Bar — top -->
    <LinearLayout
        android:id="@+id/telemetry_bar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="top"
        android:background="#AA000000"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_battery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BAT: --%"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_altitude"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ALT: --m"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tv_speed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SPD: --m/s"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tv_gps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GPS: --"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="end"/>

    </LinearLayout>

    <!-- LEFT SIDE: Takeoff / Land / Gimbal — semi transparent -->
    <LinearLayout
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginLeft="12dp"
        android:orientation="vertical"
        android:alpha="0.75">

        <Button
            android:id="@+id/btn_takeoff"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/round_btn"
            android:text="Take Off"
            android:textAllCaps="false"
            android:textColor="@color/common_text_color"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/btn_land"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/round_btn"
            android:text="Land"
            android:textAllCaps="false"
            android:textColor="@color/common_text_color"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/btn_gimbal_up"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/round_btn"
            android:text="Gimbal Up"
            android:textAllCaps="false"
            android:textColor="@color/common_text_color"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/btn_gimbal_down"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/round_btn"
            android:text="Gimbal Down"
            android:textAllCaps="false"
            android:textColor="@color/common_text_color"
            android:textSize="12sp"/>

    </LinearLayout>

    <!-- RIGHT SIDE: Photo / Record — semi transparent -->
    <LinearLayout
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginRight="12dp"
        android:orientation="vertical"
        android:alpha="0.75">

        <Button
            android:id="@+id/btn_photo"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/round_btn"
            android:text="Take Photo"
            android:textAllCaps="false"
            android:textColor="@color/common_text_color"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/btn_record"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/round_btn"
            android:text="Start Record"
            android:textAllCaps="false"
            android:textColor="@color/common_text_color"
            android:textSize="12sp"/>

    </LinearLayout>

</FrameLayout>